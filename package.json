{
  "name": "sogok-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The adversarial red-teaming memecoin ($SOGOK) with an autonomous TEE-guarded treasury bounty on NEAR.",
  "scripts": {
    "build": "npm --prefix app run build",
    "start": "npm --prefix app start",
    "dev:app": "npm --prefix app run dev",
    "dev:tee": "pnpm --prefix tee-guardian dev",
    "start:tee": "node tee-guardian/dist/index.js",
    "build:contracts": "cargo build --manifest-path contracts/Cargo.toml --target wasm32-unknown-unknown --release",
    "build:tee": "pnpm --prefix tee-guardian run build",
    "build:app": "npm --prefix app run build",
    "build:all": "npm run build:contracts && npm run build:tee && npm run build:app",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "test:tee": "node --test tee-guardian/dist/attestation.test.js",
    "test:all": "npm run test:contracts && npm run test:tee"
  },
  "keywords": [
    "near",
    "nep-141",
    "nep-297",
    "memecoins",
    "tee",
    "intel-sgx",
    "adversarial-ai",
    "red-teaming"
  ],
  "author": "SOGOK Core Protocol",
  "license": "MIT"
}
